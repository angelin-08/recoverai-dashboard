# Database Configuration
# Use SQLite for local development/tests or PostgreSQL for production
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/recoverai
# Example SQLite: sqlite:///./recoverai.db
DATABASE_URL=sqlite:///./recoverai.db

# Application Configuration
APP_ENV=development
APP_NAME=RecoverAI
DEBUG=True
API_PREFIX=/api

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI Service Configuration
# If OPENAI_API_KEY is not set or empty, RecoverAI automatically operates in deterministic Mock AI mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay Test Mode Configuration
# When keys are omitted, RecoverAI operates in deterministic DEMO mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENVIRONMENT=test

# Guardrail Defaults
MAX_AUTOMATED_ATTEMPTS=2
MAX_AUTOMATED_AMOUNT=10000.0
HUMAN_APPROVAL_THRESHOLD=10000.0
RECOVERY_WINDOW_HOURS=48
MIN_CONFIDENCE_THRESHOLD=70.0
